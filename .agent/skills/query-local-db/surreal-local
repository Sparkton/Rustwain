#!/bin/zsh
# Connect to a local SurrealDB instance with dev credentials.
# Override defaults with SURREAL_ENDPOINT, SURREAL_NS, SURREAL_DB, SURREAL_USER, SURREAL_PASS.
# Usage:
#   surreal-local                                       # opens interactive REPL
#   echo "SELECT * FROM item LIMIT 5;" | surreal-local  # pipe queries
endpoint="${SURREAL_ENDPOINT:-ws://localhost:8000}"
case "$endpoint" in
  ws://localhost*|ws://127.0.0.1*|http://localhost*|http://127.0.0.1*) ;;
  *) echo "surreal-local: refusing non-local endpoint $endpoint" >&2; exit 1 ;;
esac
exec surreal sql \
  --endpoint "$endpoint" \
  --ns "${SURREAL_NS:-app}" --db "${SURREAL_DB:-app}" \
  --item "${SURREAL_USER:-root}" --pass "${SURREAL_PASS:-root}" \
  --pretty \
  --hide-welcome \
  "$@"
